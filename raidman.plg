<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "raidman">
<!ENTITY author    "Routecore">
<!-- Do not edit version or sha256 by hand. The release workflow
     (.github/workflows/build-plugin.yml) sets version to the pushed tag and
     sha256 to the SHA-256 of that tag's package, publishes the release and
     then commits both lines to main, so the copy on main always describes a
     published package. See "Releasing" in README.md. -->
<!ENTITY version   "2026.11.18">
<!ENTITY sha256    "">
<!ENTITY launch    "Settings/raidman">
<!ENTITY gitURL    "https://github.com/routecore/raidman-plugin">
<!ENTITY pluginURL "https://raw.githubusercontent.com/routecore/raidman-plugin/main/raidman.plg">
<!ENTITY pkgName   "raidman-&version;.tgz">
<!ENTITY pkgURL    "&gitURL;/releases/download/&version;/&pkgName;">
<!ENTITY plgDir    "/boot/config/plugins/&name;">
]>
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;" pluginURL="&pluginURL;" icon="icon.png" min="7.0.0" support="&gitURL;/issues">

<CHANGES>
<CHANGE>2026.11.18 - Unraid API key compatibility (roles and permission-scoped keys), deny-by-default permission checks, VNC/terminal stability, correct parity pause/resume and spin up/down, Unraid 7.3 boot device, versioned and checksummed package (noVNC included), rc.raidman service script with crash restart, log rotation. Protocol 2: health/feature discovery, Docker update status and template metadata (WebUI, icon, shell), spin-safe disk state, per-disk spin, mover start/stop, explicit parity actions, clean shutdown/reboot, terminal resize and docker exec shell choice, plugin list/update/remove, SMART data, read-only file browser (ADMIN; secrets on the flash drive are refused), memory breakdown, NUT UPS status, the encrypted-array Start status and keyfile delete of the web UI. The container console and the VM serial console now require the ADMIN role</CHANGE>
<CHANGE>2026.06.21 - Array disk filesystem usage, spin state, and improved I/O stats</CHANGE>
<CHANGE>2026.06.14 - Bug fixes and robustness improvements</CHANGE>
<CHANGE>2026.02.10 - Initial Release</CHANGE>
</CHANGES>

<!--
Versioned package (binary, settings page, nginx snippet, rc script, icon,
noVNC), verified by SHA-256. A new version always has a new file name, so the plugin
manager never reuses a stale copy from the flash drive.
-->
<FILE Name="&plgDir;/&pkgName;">
<URL>&pkgURL;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!--
The 'install' script.
-->
<FILE Run="/bin/bash" Method="install">
<INLINE>
<![CDATA[
VERSION="]]>&version;<![CDATA["
PKG_SHA256="]]>&sha256;<![CDATA["
PLGDIR=/boot/config/plugins/raidman
EMHTTP=/usr/local/emhttp/plugins/raidman
PKG="$PLGDIR/raidman-$VERSION.tgz"
NGINX=/usr/sbin/nginx
LOCATIONS=/etc/nginx/conf.d/locations.conf
NGINX_CONF=/etc/nginx/conf.d/raidman.conf
INCLUDE_LINE="include /etc/nginx/conf.d/raidman.conf;"
# Tells the daemon's nginx monitor to reload nginx once nginx -t passes
# (src/internal/monitor/nginx.go).
RELOAD_PENDING=/var/run/raidman-nginx-reload
# Every file the package must contain (scripts/check-package.sh reads this line).
REQUIRED_FILES="raidman raidman.page raidman.conf rc.raidman icon.png web/novnc/vnc.html"

echo "Installing RaidMan $VERSION..."

# -------------------------------------------------
# Requirements
# -------------------------------------------------
if [ ! -d /boot/config/plugins/dynamix.my.servers ] && [ ! -d /usr/local/unraid-api ] && [ ! -e /etc/rc.d/rc.unraid-api ]; then
  echo ""
  echo "WARNING: The Unraid API was not found."
  echo "  RaidMan authenticates the app with Unraid API keys."
  echo "  - Unraid 7.2 and later: the API is built in (Settings > Management Access > API Keys)."
  echo "  - Unraid 7.0 / 7.1: install the Unraid Connect plugin to get the API."
  echo "  RaidMan will start anyway and load keys as soon as they are created."
  echo ""
fi

# -------------------------------------------------
# Verify the package (the plugin manager skips an empty <SHA256>, so the
# checksum is enforced here as well; a bad copy is deleted so the next
# install downloads it again)
# -------------------------------------------------
if [ -z "$PKG_SHA256" ]; then
  echo "ERROR: this raidman.plg has no package checksum (unreleased build); refusing to install."
  exit 1
fi
if [ ! -f "$PKG" ] || [ "$(sha256sum "$PKG" | awk '{print $1}')" != "$PKG_SHA256" ]; then
  echo "ERROR: $PKG is missing or does not match the expected SHA-256; removing it. Please retry the installation."
  rm -f "$PKG"
  exit 1
fi

# -------------------------------------------------
# Unpack
# -------------------------------------------------
TMP=$(mktemp -d /tmp/raidman.XXXXXX)
if ! tar -xzf "$PKG" -C "$TMP"; then
  echo "ERROR: could not unpack $PKG"
  rm -rf "$TMP"
  exit 1
fi
for f in $REQUIRED_FILES; do
  if [ ! -f "$TMP/$f" ]; then
    echo "ERROR: package is incomplete ($f missing)"
    rm -rf "$TMP"
    exit 1
  fi
done

# -------------------------------------------------
# Stop the running daemon (new rc script also stops pre-rc.raidman instances)
# -------------------------------------------------
install -m 0755 "$TMP/rc.raidman" /etc/rc.d/rc.raidman
/etc/rc.d/rc.raidman stop

mkdir -p "$EMHTTP"
install -m 0755 "$TMP/raidman" "$EMHTTP/raidman"
install -m 0644 "$TMP/raidman.page" "$EMHTTP/raidman.page"
install -m 0644 "$TMP/icon.png" "$EMHTTP/icon.png"

# noVNC for the in-app VM console, pinned and covered by the package SHA-256
# (replaced on every install, never taken from the OS or downloaded).
rm -rf "$EMHTTP/web/novnc"
mkdir -p "$EMHTTP/web"
if ! cp -R "$TMP/web/novnc" "$EMHTTP/web/novnc"; then
  echo "WARNING: could not install noVNC; everything except the in-app VM console works."
fi

# -------------------------------------------------
# Log rotation: Unraid's periodic logrotate run keeps /var/log/raidman.log
# (on the small /var/log tmpfs) under 5 MB while the daemon runs.
# copytruncate is safe: the daemon's log is opened with O_APPEND.
# -------------------------------------------------
cat > /etc/logrotate.d/raidman <<'LOGROTATE'
/var/log/raidman.log {
    size 5M
    rotate 1
    copytruncate
    missingok
    notifempty
    nocompress
}
LOGROTATE
chmod 0644 /etc/logrotate.d/raidman

# -------------------------------------------------
# Nginx: install the location snippet and include it from locations.conf.
# Only touch locations.conf when nginx currently accepts its configuration;
# roll back only if *our* change makes nginx -t fail. If nginx is not ready
# (locations.conf not generated yet, or already broken by something else) the
# snippet is installed and the daemon's nginx monitor adds the include once
# nginx -t passes (it re-checks every minute and whenever locations.conf
# changes).
# -------------------------------------------------
echo "Configuring nginx..."
if [ ! -f "$LOCATIONS" ] || ! PRECHECK=$($NGINX -t 2>&1); then
  # No reload here. On an update the include is already present, so the
  # monitor's injection never reloads either: leave a marker so a changed
  # snippet is still loaded once nginx -t passes.
  if [ ! -f "$NGINX_CONF" ] || [ "$(sha256sum < "$TMP/raidman.conf")" != "$(sha256sum < "$NGINX_CONF")" ]; then
    touch "$RELOAD_PENDING"
  fi
  install -m 0644 "$TMP/raidman.conf" "$NGINX_CONF"
  if [ ! -f "$LOCATIONS" ]; then
    echo "nginx locations.conf not generated yet; RaidMan will add its include when nginx starts."
  else
    echo "WARNING: nginx configuration is currently invalid (not caused by RaidMan):"
    echo "$PRECHECK"
    echo "RaidMan re-checks every minute and adds its include once nginx -t passes."
  fi
else
  CONF_BACKUP=""
  if [ -f "$NGINX_CONF" ]; then
    CONF_BACKUP="$TMP/raidman.conf.previous"
    cp -p "$NGINX_CONF" "$CONF_BACKUP"
  fi
  install -m 0644 "$TMP/raidman.conf" "$NGINX_CONF"

  LOC_BACKUP=""
  if ! grep -qF "$INCLUDE_LINE" "$LOCATIONS"; then
    LOC_BACKUP="$TMP/locations.conf.previous"
    cp -p "$LOCATIONS" "$LOC_BACKUP"
    printf '\n%s\n' "$INCLUDE_LINE" >> "$LOCATIONS"
  fi

  if NGINX_TEST=$($NGINX -t 2>&1); then
    if [ -f /var/run/nginx.pid ]; then
      if $NGINX -s reload; then
        echo "nginx reloaded"
        rm -f "$RELOAD_PENDING"
      else
        echo "WARNING: nginx reload failed; RaidMan retries once nginx -t passes."
        touch "$RELOAD_PENDING"
      fi
    fi
  else
    echo "WARNING: nginx rejected the RaidMan configuration; rolling back:"
    echo "$NGINX_TEST"
    if [ -n "$LOC_BACKUP" ]; then
      cp -p "$LOC_BACKUP" "$LOCATIONS"
    fi
    if [ -n "$CONF_BACKUP" ]; then
      cp -p "$CONF_BACKUP" "$NGINX_CONF"
    else
      rm -f "$NGINX_CONF"
      sed -i '\#include /etc/nginx/conf.d/raidman.conf;#d' "$LOCATIONS"
    fi
  fi
fi

rm -rf "$TMP"

# -------------------------------------------------
# Remove stale copies from the flash drive: older versioned packages and the
# fixed-name files used by plugin versions up to 2026.06.21.
# -------------------------------------------------
find "$PLGDIR" -maxdepth 1 -type f -name 'raidman-*.tgz' ! -name "raidman-$VERSION.tgz" -delete
rm -f "$PLGDIR/raidman" "$PLGDIR/raidman.page" "$PLGDIR/raidman.conf" "$PLGDIR/icon.png"

# -------------------------------------------------
# Start the service (supervised: restarted with a backoff if it crashes)
# -------------------------------------------------
/etc/rc.d/rc.raidman start

echo ""
echo " RaidMan has been installed."
echo " Copyright 2026, Routecore LLC"
echo " Version: $VERSION"
echo ""
]]>
</INLINE>
</FILE>

<!--
The 'remove' script.
-->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
if [ -x /etc/rc.d/rc.raidman ]; then
  /etc/rc.d/rc.raidman stop
else
  pkill -TERM -x raidman 2>/dev/null
fi
rm -f /etc/rc.d/rc.raidman /etc/logrotate.d/raidman
rm -f /var/run/raidman.pid /var/run/raidman-supervisor.pid /var/run/raidman-supervisor.lock /var/run/raidman.stopped /var/run/raidman-nginx-reload
rm -f /var/log/raidman.log /var/log/raidman.log.1 /var/log/raidman-update.log

# Clean up nginx configuration (include first, so nginx never references a
# missing file)
if [ -f /etc/nginx/conf.d/locations.conf ]; then
  sed -i '\#include /etc/nginx/conf.d/raidman.conf;#d' /etc/nginx/conf.d/locations.conf
fi
rm -f /etc/nginx/conf.d/raidman.conf
if /usr/sbin/nginx -t >/dev/null 2>&1 && [ -f /var/run/nginx.pid ]; then
  /usr/sbin/nginx -s reload
fi

# Remove files
rm -rf /usr/local/emhttp/plugins/raidman

# Remove configuration
rm -rf /boot/config/plugins/raidman

echo ""
echo " RaidMan has been uninstalled."
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
